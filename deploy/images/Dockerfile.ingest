# dmp-ingest：Go Collector（/v1/events 神策相容、/sa 批次）；多階段建置，distroless 執行
# CDC（Debezium）不自建映像，由 Strimzi KafkaConnect 以官方 connector 映像執行（kafka.connect in values）
FROM golang:1.23 AS build
WORKDIR /src
COPY apps/collector/ .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/collector ./cmd/collector
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/collector /collector
EXPOSE 8081
ENTRYPOINT ["/collector"]

# deploy/compose/.env — 三台 VM 共用；複製成 .env 後填入，不要提交。密碼一律由密鑰庫（OpenBao／HSM）在部署時注入，這裡只放 secret_ref 對應後的值。
# 映像倉（永豐內部 Harbor 或 Artifact Registry 鏡像）與版本（docs/32；M1 開工依當時 LTS 重釘）
REGISTRY=harbor.sinopac.internal/dmp
DMP_TAG=1.0.0
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
KEEPER_IMAGE=clickhouse/clickhouse-keeper:25.8
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:8.2-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.80
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:25.0
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana-oss:11.3.1
LOKI_IMAGE=grafana/loki:3.3.2
ALLOY_IMAGE=grafana/alloy:v1.5.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.51.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
RCLONE_IMAGE=rclone/rclone:1.68

# 三台 VM 的內網位址（容器用 host 網路，直接用這些位址互連）
VM1_HOST=10.10.0.11
VM2_HOST=10.10.0.12
VM3_HOST=10.10.0.13
VM_HOST=10.10.0.11          # 本機；每台 VM 的 .env 各自改成自己的位址
KEEPER_ID=1                 # 本機 Keeper server_id：VM1=1、VM2=2、VM3=3
CH_REPLICA=r1               # 本機 ClickHouse 副本名：VM1=r1、VM2=r2（VM3 不跑 ClickHouse）
PG_PRIMARY_HOST=10.10.0.11  # 應用一律連名稱 pg-primary（docs/44 §5.1）；接管時改成新主庫位址、重啟應用容器，不改連線字串

# 服務帳號與密碼（值由密鑰庫注入，secret_ref 見 docs/06 §4）
CH_USER=dmp
CH_PASSWORD=__from_secret_ref__dmp/clickhouse/password
PG_USER=dmp
PG_PASSWORD=__from_secret_ref__dmp/postgres/password
PG_REPL_PASSWORD=__from_secret_ref__dmp/postgres/replication
REDIS_PASSWORD=__from_secret_ref__dmp/redis/password
S3_ACCESS_KEY=dmp
S3_SECRET_KEY=__from_secret_ref__dmp/seaweedfs/secret
KEYCLOAK_ADMIN_PASSWORD=__from_secret_ref__dmp/keycloak/admin
GRAFANA_ADMIN_PASSWORD=__from_secret_ref__dmp/grafana/admin
DMP_METRICS_TOKEN=__from_secret_ref__dmp/api/metrics-token

# 應用設定
DMP_IDP_MODE=broker         # broker＝Keycloak（再 broker 到永豐 AD）；direct＝直連 Entra／AD／本機帳號。只接受這兩個值（#80）
DMP_PUBLIC_URL=https://dmp.sinopac.internal   # F5／HAProxy 對外網址（TLS 在 LB 終結，內部 CA）
DMP_SECRETS_GID=10500       # 主機群組 dmp-secrets 的 GID；密鑰檔 root:此群組 0440，只有掛了 group_add 的容器讀得到
DMP_SECRETS_JSON=/run/secrets/dmp-secrets.json # 密鑰庫掛載的 secret_ref → 明文 對照檔

# 資料目錄（SSD 資料碟）與備份目的地（永豐 NAS 掛載點）
DATA_ROOT=/data/dmp
APP_UID=10001               # dmp-core 映像的執行 UID；APP_DATA 與同步快照都歸它所有（0700／0600）
APP_DATA=/data/dmp/app      # API 與 worker 共用（同一台）：同步排程狀態 sched.db、看板／匯出產出檔（docs/44 §5a）；VM1 每 15 分鐘同步到 VM2
NAS_BACKUP=/mnt/nas/dmp-backup

# 應用容器的 bridge 網段（固定，資料庫允許清單才能精準放行）：容器經 host.docker.internal 連本機 ClickHouse／PostgreSQL 時來源是這個網段。
# 改這裡要同步改 common/clickhouse/users.xml 與 common/postgres/pg_hba.conf；不可與 10.10.0.0/24 或永豐內網重疊。
APP_SUBNET=172.30.0.0/24

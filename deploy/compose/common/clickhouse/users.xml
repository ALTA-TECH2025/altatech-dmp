<!-- 使用者與設定檔（docs/23 §4.10 的三種 profile）：帳號密碼從環境變數帶入；default 帳號停用網路存取 -->
<clickhouse>
    <profiles>
        <default><max_memory_usage>12000000000</max_memory_usage><max_execution_time>60</max_execution_time><max_threads>8</max_threads></default>
        <human><max_bytes_to_read>50000000000</max_bytes_to_read><max_execution_time>30</max_execution_time><max_concurrent_queries_for_user>4</max_concurrent_queries_for_user><max_memory_usage>12000000000</max_memory_usage></human>
        <batch><priority>10</priority><max_threads>10</max_threads><max_memory_usage>40000000000</max_memory_usage></batch>
        <sql_user><max_bytes_to_read>10000000000</max_bytes_to_read><max_execution_time>10</max_execution_time><max_memory_usage>4000000000</max_memory_usage><readonly>1</readonly></sql_user>
    </profiles>
    <users>
        <default><password></password><networks><ip>127.0.0.1</ip></networks><profile>default</profile><quota>default</quota></default>
        <dmp>
            <password from_env="CH_PASSWORD"/>
            <networks><ip>10.10.0.0/24</ip><ip>127.0.0.1</ip></networks>
            <profile>default</profile><quota>default</quota>
            <access_management>1</access_management>
        </dmp>
    </users>
    <quotas><default><interval><duration>3600</duration><queries>0</queries><errors>0</errors><result_rows>0</result_rows><read_rows>0</read_rows><execution_time>0</execution_time></interval></default></quotas>
</clickhouse>

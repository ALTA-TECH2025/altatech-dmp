<!-- ClickHouse 正式設定（docs/07 §1.3）：1 分片 2 副本，Keeper 3 節點。主機位址與副本名從環境變數帶入（from_env），三台用同一份檔。 -->
<clickhouse>
    <logger><level>information</level><console>1</console></logger>
    <listen_host>0.0.0.0</listen_host>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <interserver_http_port>9009</interserver_http_port>
    <interserver_http_host from_env="VM_HOST"/>
    <max_connections>512</max_connections>
    <max_concurrent_queries>100</max_concurrent_queries>
    <mark_cache_size>5368709120</mark_cache_size>
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>
    <macros>
        <shard>01</shard>
        <replica from_env="CH_REPLICA"/>
        <cluster>dmp</cluster>
    </macros>
    <zookeeper>
        <node><host from_env="VM1_HOST"/><port>9181</port></node>
        <node><host from_env="VM2_HOST"/><port>9181</port></node>
        <node><host from_env="VM3_HOST"/><port>9181</port></node>
    </zookeeper>
    <remote_servers>
        <dmp>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host from_env="VM1_HOST"/><port>9000</port><user from_env="CH_USER"/><password from_env="CH_PASSWORD"/></replica>
                <replica><host from_env="VM2_HOST"/><port>9000</port><user from_env="CH_USER"/><password from_env="CH_PASSWORD"/></replica>
            </shard>
        </dmp>
    </remote_servers>
    <!-- 備份目的地：SeaweedFS S3（VM2），再由 VM3 的 backup 作業同步到永豐 NAS -->
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/backups/</allowed_path>
    </backups>
    <storage_configuration>
        <disks>
            <backups>
                <type>s3</type>
                <endpoint from_env="S3_BACKUP_ENDPOINT"/>
                <access_key_id from_env="S3_ACCESS_KEY"/>
                <secret_access_key from_env="S3_SECRET_KEY"/>
            </backups>
        </disks>
    </storage_configuration>
    <query_cache><max_size_in_bytes>1073741824</max_size_in_bytes></query_cache>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>

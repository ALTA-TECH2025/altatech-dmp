{
 "title": "AltaTech DMP · 平台／資料流／查詢／推送",
 "uid": "dmp-overview",
 "tags": [
  "dmp"
 ],
 "timezone": "Asia/Taipei",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "type": "datasource",
    "query": "prometheus",
    "label": "Prometheus",
    "current": {}
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "name": "告警",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "enable": true,
    "expr": "ALERTS{alertstate=\"firing\", key=~\"source_lag|sync_failed|events_stale|http_errors|delivery_dlq\"}",
    "iconColor": "red",
    "titleFormat": "{{alertname}}"
   }
  ]
 },
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "平台",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "id": 1,
   "type": "timeseries",
   "title": "API 請求率（/s）",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(dmp_http_requests_total[5m]))",
     "legendFormat": "all"
    },
    {
     "refId": "B",
     "expr": "sum(rate(dmp_http_requests_total{status=~\"5..\"}[5m]))",
     "legendFormat": "5xx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "API P95（秒）",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(dmp_http_request_seconds_bucket[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(dmp_http_request_seconds_bucket[5m])))",
     "legendFormat": "p50"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "5xx 比例",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(dmp_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(dmp_http_requests_total[5m]))",
     "legendFormat": "5xx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.02
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "程序啟動至今",
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 7
